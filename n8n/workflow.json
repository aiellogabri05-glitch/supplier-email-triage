    {
      "parameters": {
        "operation": "append",
        "documentId": { "__rl": true, "mode": "id", "value": "REPLACE_WITH_TEST_SHEET_ID" },
        "sheetName": { "__rl": true, "mode": "name", "value": "Decision log" },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "logged_at": "={{ $now.toISO() }}",
            "email_id": "={{ $('Classify email').item.json.email_id }}",
            "category": "={{ $('Classify email').item.json.category }}",
            "confidence": "={{ $('Classify email').item.json.confidence }}",
            "route": "={{ $('Classify email').item.json.route }}"
          }
        },
        "options": {}
      },
      "id": "a1b2c009-0000-4000-8000-000000000009",
      "name": "Decision log",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [-120, 300],
      "credentials": {
        "googleSheetsOAuth2Api": { "id": "REPLACE_WITH_GOOGLE_CREDENTIAL_ID", "name": "Google Sheets test account" }
      }
    }
  ],
