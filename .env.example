# Copy to .env and fill in. .env is git-ignored. Never commit real keys.

# LLM provider for the classifier. The client speaks the OpenAI-compatible API, so the
# same three variables work for OpenAI and for other providers that expose that API.
#
# OpenAI:              LLM_BASE_URL empty, LLM_MODEL=gpt-4.1-mini
# NVIDIA NIM:          LLM_BASE_URL=https://integrate.api.nvidia.com/v1, LLM_MODEL = a NIM model id
#
# The brief asks for the OpenAI API. Name the provider and model you actually used in the portfolio.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-4.1-mini

# Emails with confidence below this, or in category "other", go to the review route.
CONFIDENCE_THRESHOLD=0.75

# Used by n8n when run from docker-compose.yml. Its IMAP and Google/Slack credentials are
# entered in the n8n UI, not here.
TRIAGE_API_URL=http://localhost:8000
